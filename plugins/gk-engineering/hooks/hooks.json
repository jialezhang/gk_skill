{
  "description": "Provides best-effort Terra routing diagnostics; raw native spawn and rollout evidence remain authoritative.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/terra_route_guard.py\"",
            "timeout": 5,
            "statusMessage": "Validating Terra implementation route"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/terra_route_guard.py\"",
            "timeout": 5,
            "statusMessage": "Verifying subagent model and permissions"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/terra_route_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
